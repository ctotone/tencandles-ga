<article
  class="ets-design2-card etc-instant-chat-card {{#if blockedByConflict}}is-suspended{{/if}} {{#if resolvedSuccess}}is-success{{/if}} {{#if resolvedFailure}}is-failure{{/if}} {{#if cancelled}}is-cancelled{{/if}}"
  data-instant-request-id="{{request.id}}"
>
  <header class="ets-design2-card__header etc-instant-chat-header">
    <h3>{{localize "ETC.Instant.ChatTitle" name=request.actorName}}</h3>
  </header>

  {{#if request.instantText}}
    <blockquote class="etc-instant-chat-text">{{request.instantText}}</blockquote>
  {{/if}}

  {{#if awaitingDecision}}
    <p class="ets-design2-card__body">{{localize "ETC.Instant.ChatQuestion"}}</p>

    <div class="etc-instant-chat-actions" data-instant-actions>
      <button
        type="button"
        class="ets-design2-action is-instant-success"
        data-instant-action="success"
      >
        <i class="fa-solid fa-check" aria-hidden="true"></i>
        <span>{{localize "ETC.Instant.Success"}}</span>
      </button>

      <button
        type="button"
        class="ets-design2-action is-instant-failure"
        data-instant-action="failure"
      >
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        <span>{{localize "ETC.Instant.Failure"}}</span>
      </button>
    </div>
  {{/if}}

  {{#if blockedByConflict}}
    <section class="etc-instant-chat-status">
      <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
      <div>
        <strong>{{localize "ETC.Instant.SuspendedTitle"}}</strong>
        <span>{{localize "ETC.Instant.SuspendedBody"}}</span>
      </div>
    </section>
  {{/if}}

  {{#if resolvedSuccess}}
    <section class="etc-instant-chat-status is-success">
      <i class="fa-solid fa-check" aria-hidden="true"></i>
      <div>
        <strong>{{localize "ETC.Instant.ResolvedSuccessTitle"}}</strong>
        <span>
          {{localize "ETC.Instant.ResolvedSuccessBody" name=request.actorName}}
        </span>
      </div>
    </section>
  {{/if}}

  {{#if resolvedFailure}}
    <section class="etc-instant-chat-status is-failure">
      <i class="fa-solid fa-cloud" aria-hidden="true"></i>
      <div>
        <strong>{{localize "ETC.Instant.ResolvedFailureTitle"}}</strong>
        <span>
          {{localize "ETC.Instant.ResolvedFailureBody" name=request.actorName}}
        </span>
      </div>
    </section>
  {{/if}}

  {{#if cancelled}}
    <section class="etc-instant-chat-status is-cancelled">
      <i class="fa-solid fa-ban" aria-hidden="true"></i>
      <div>
        <span>{{localize "ETC.Instant.Cancelled"}}</span>
      </div>
    </section>
  {{/if}}
</article>
